# Modèle de configuration serveur — SANS SECRET.
# Copiez-le en server/.env.local (ignoré par git) et renseignez les valeurs.

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_EXPIRES_IN=7d

# Pour développer, visez une base distincte de la production :
# .../stock_management_dev plutôt que .../stock_management
MONGODB_URI=

JWT_SECRET=
