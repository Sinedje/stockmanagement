# Modèle de configuration — SANS SECRET.
# Copiez-le en .env.local (ignoré par git) et renseignez les valeurs reçues
# de votre responsable technique.

# API Express + MongoDB
VITE_API_URL=http://localhost:5000/api

# Supabase — multi-entreprises.
# Clé « publishable » : publique par conception, l'isolation est assurée par
# la Row Level Security côté base.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
